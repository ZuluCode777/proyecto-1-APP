# Modelo local de Ollama para que el asistente entienda frases libres.
#
# Sin estas variables, el asistente usa las reglas de `lib/local-agent.ts`,
# que funcionan sin red. Con ellas, Ollama interpreta la frase y las reglas
# quedan de respaldo si el modelo no responde o devuelve algo que no cuadra
# con los datos.
#
# El modelo tiene que estar descargado. Probado con: `ollama pull qwen2.5:3b`
# Ollama tiene que correr en la misma máquina que la app, o en una dirección
# que la app pueda alcanzar.
# OLLAMA_MODEL=qwen2.5:3b
OLLAMA_MODEL=
# En la máquina con Windows, la instancia propia de TransMiVoz:
# OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Clave de acceso. Con ella, la app pide la clave (HTTP Basic) en toda
# petición; el usuario puede ser cualquiera. Hace falta al publicarla en
# internet con Tailscale Funnel. Vacía, la app no pide nada.
APP_PASSWORD=
